{
    "name": "gammamatrix/playground-cms-api",
    "description": "Playground: Provides an API, without a UI for interacting with Playground CMS, a Content Management System for Laravel applications.",
    "keywords": [
        "cms",
        "content management system",
        "gammamatrix",
        "laravel",
        "playground"
    ],
    "homepage": "https://github.com/gammamatrix/playground-cms-api",
    "license": "MIT",
    "authors": [
        {
            "name": "Jeremy Postlethwaite",
            "email": "jeremy.postlethwaite@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "gammamatrix/playground-auth": "*",
        "gammamatrix/playground-http": "*",
        "gammamatrix/playground-cms": "*"
    },
    "require-dev": {
        "gammamatrix/playground-test": "*",
        "laravel/sanctum": "^4.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Playground\\Cms\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Feature\\Playground\\Cms\\Api\\": "tests/Feature/",
            "Tests\\Unit\\Playground\\Cms\\Api\\": "tests/Unit/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "gammamatrix/*": "source",
            "*": "dist"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "73.x-dev",
            "dev-master": "73.x-dev"
        },
        "laravel": {
            "providers": [
                "Playground\\Cms\\Api\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --verbose --debug --level max",
        "cloc": "cloc --exclude-dir=node_modules,output,vendor .",
        "format": "vendor/bin/php-cs-fixer fix",
        "test": "vendor/bin/phpunit"
    }
}
